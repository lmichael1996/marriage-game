<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow all direct file access (images, CSS, JS, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Allow all directory access
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else to PHP files
    RewriteRule ^(.*)$ index.php?request=$1 [QSA,L]
</IfModule>
